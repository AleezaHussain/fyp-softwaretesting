# ================================
# Recommender API (Python/FastAPI)
# ================================

# OpenRouter API key for description generation
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use for description generation (optional)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Allowed CORS origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# ML Model path (optional, defaults to cooling_recommender_rf.pkl)
MODEL_PATH=cooling_recommender_rf.pkl

# Recommendation weights (optional)
WEIGHT_COST=0.5
WEIGHT_EMISSIONS=0.3
WEIGHT_WATER=0.2

# ── Groq API Keys ─────────────────────────────────────────────────
# Main advisory/chat key (used by advisory_api.py)
GROQ_API_KEY=gsk_your_main_key_here

# Dedicated key for ML recommendation justification + future impact
# Get a separate key at: https://console.groq.com/keys
# Falls back to GROQ_API_KEY if not set
ML_GROQ_API_KEY=gsk_your_ml_key_here

# ================================
# Frontend (Vite) - use VITE_ prefix
# ================================

# Recommender API URL (optional, defaults to http://localhost:8001)
VITE_RECOMMENDER_API_URL=http://localhost:8001

# Supabase credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Chilled Water Cooling System Backend API
REACT_APP_CHILLED_WATER_API_URL=http://localhost:8080/api/v1
